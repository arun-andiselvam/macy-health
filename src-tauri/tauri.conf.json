{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macy Health",
  "version": "0.1.0",
  "identifier": "com.arun.macyhealth",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Macy Health Settings",
        "width": 720,
        "height": 540,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Gentle reminders to drink water, rest your eyes and stand up.",
    "longDescription": "Macy Health lives in your menu bar and reminds you to drink water, rest your eyes and stand up, on a schedule you choose.",
    "copyright": "\u00a9 2026 HITASOFT TECHNOLOGY SOLUTIONS PRIVATE LIMITED",
    "publisher": "HITASOFT TECHNOLOGY SOLUTIONS PRIVATE LIMITED",
    "macOS": {
      "signingIdentity": "Developer ID Application: HITASOFT TECHNOLOGY SOLUTIONS PRIVATE LIMITED (PQH88KC8RZ)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    }
  }
}
